# ==========================================================
# VERTEXIA OS — PRODUCTION & VERCEL DEPLOYMENT CONFIGURATION
# ==========================================================

# 1. MongoDB Atlas Database Connection
# In MongoDB Atlas: Click "Connect" -> "Drivers" -> Copy your connection string.
# Example: mongodb+srv://vertexia_admin:YourStrongPassword@cluster0.abcde.mongodb.net/vertexia_os?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vertexia_os?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vertexia_os?retryWrites=true&w=majority"

# 2. Authentication Secret Key (Minimum 32 characters)
APP_SECRET="vertexia-os-production-secret-key-32chars-min-981247"

# 3. Application Metadata & Regional Localization
NEXT_PUBLIC_APP_NAME="Vertexia OS"
NEXT_PUBLIC_APP_TAGLINE="One Platform. Complete Business Control."
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Karachi"
