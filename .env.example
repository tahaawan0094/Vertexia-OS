# Environment variables example for Vertexia OS
# For SQLite (default local dev):
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vertexia_os?schema=public"

APP_SECRET="replace-with-a-secure-random-32-char-string"
NEXT_PUBLIC_APP_NAME="Vertexia OS"
NEXT_PUBLIC_APP_TAGLINE="One Platform. Complete Business Control."
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Karachi"
